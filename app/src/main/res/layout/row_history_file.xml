<com.ephemeral.android.ui.history.SquareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    android:background="@drawable/bg_bubble_file"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/history_grid_file_cell_padding">

    <FrameLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="@dimen/history_grid_file_icon_size"
            android:layout_height="@dimen/history_grid_file_icon_size"
            android:contentDescription="@string/view"
            android:src="@drawable/ic_file" />

        <ImageView
            android:id="@+id/image_public_indicator"
            android:layout_width="16dp"
            android:layout_height="16dp"
            android:layout_gravity="top|end"
            android:padding="2dp"
            android:background="@drawable/bg_public_badge"
            android:src="@drawable/ic_link"
            android:tint="@color/color_primary"
            android:visibility="gone" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_filename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/history_grid_filename_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/history_grid_metadata_text" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/space_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/history_grid_action_size"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_view"
            android:layout_width="@dimen/history_grid_action_size"
            android:layout_height="@dimen/history_grid_action_size"
            android:background="@drawable/bg_icon_small_ripple"
            android:contentDescription="@string/view"
            android:src="@drawable/ic_eye"
            android:tint="@color/ic_tint" />

        <ImageButton
            android:id="@+id/button_download"
            android:layout_width="@dimen/history_grid_action_size"
            android:layout_height="@dimen/history_grid_action_size"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_icon_small_ripple"
            android:contentDescription="@string/download"
            android:src="@drawable/ic_download"
            android:tint="@color/ic_tint" />

        <ImageButton
            android:id="@+id/button_more"
            android:layout_width="@dimen/history_grid_action_size"
            android:layout_height="@dimen/history_grid_action_size"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@drawable/bg_icon_small_ripple"
            android:contentDescription="Options"
            android:src="@drawable/ic_more_vert"
            android:tint="@color/ic_tint" />
    </LinearLayout>
</com.ephemeral.android.ui.history.SquareLinearLayout>
