<com.ephemeral.android.ui.history.SquareLinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/space_xs"
    android:background="@drawable/bg_bubble_file"
    android:gravity="center_horizontal"
    android:orientation="vertical"
    android:padding="@dimen/history_grid_file_cell_padding">

    <ImageView
        android:layout_width="@dimen/history_grid_file_icon_size"
        android:layout_height="@dimen/history_grid_file_icon_size"
        android:contentDescription="@string/view"
        android:src="@drawable/ic_file" />

    <TextView
        android:id="@+id/text_filename"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/space_xs"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="2"
        android:textColor="@color/color_text_primary"
        android:textSize="@dimen/history_grid_filename_text"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/text_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:textColor="@color/color_text_secondary"
        android:textSize="@dimen/history_grid_metadata_text" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:minHeight="@dimen/space_xs" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/history_grid_action_size"
        android:gravity="center"
        android:orientation="horizontal">

        <ImageButton
            android:id="@+id/button_view"
            android:layout_width="@dimen/history_grid_action_size"
            android:layout_height="@dimen/history_grid_action_size"
            android:background="@android:color/transparent"
            android:contentDescription="@string/view"
            android:src="@drawable/ic_eye" />

        <ImageButton
            android:id="@+id/button_download"
            android:layout_width="@dimen/history_grid_action_size"
            android:layout_height="@dimen/history_grid_action_size"
            android:layout_marginStart="@dimen/space_xs"
            android:background="@android:color/transparent"
            android:contentDescription="@string/download"
            android:src="@drawable/ic_download" />
    </LinearLayout>
</com.ephemeral.android.ui.history.SquareLinearLayout>
