<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <Button
            android:id="@+id/button_logout"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary"
            android:text="@string/logout" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <Button
            android:id="@+id/button_nav_chat"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_selected"
            android:text="@string/chat" />

        <Button
            android:id="@+id/button_nav_history"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_unselected"
            android:text="@string/history" />

        <ImageButton
            android:id="@+id/button_refresh"
            android:layout_width="@dimen/touch_target"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_button_secondary"
            android:contentDescription="@string/refresh"
            android:src="@drawable/ic_refresh" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_chat"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_sm" />

        <ProgressBar
            android:id="@+id/progress_chat"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_chat_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_messages"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/panel_upload_queue"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:padding="@dimen/space_sm"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="40dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/text_upload_summary"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/upload_queue"
                android:textColor="@color/color_text_primary"
                android:textStyle="bold" />

            <ImageButton
                android:id="@+id/button_close_uploads"
                android:layout_width="@dimen/touch_target"
                android:layout_height="@dimen/touch_target"
                android:background="@android:color/transparent"
                android:contentDescription="@string/close"
                android:src="@drawable/ic_close" />
        </LinearLayout>

        <ProgressBar
            android:id="@+id/progress_upload_total"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:max="100" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_uploads"
            android:layout_width="match_parent"
            android:layout_height="160dp"
            android:visibility="gone" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <ImageButton
            android:id="@+id/button_attach"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/attach"
            android:src="@drawable/ic_attach" />

        <EditText
            android:id="@+id/input_composer"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_marginEnd="@dimen/space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_text_field"
            android:gravity="top"
            android:inputType="textMultiLine|textCapSentences"
            android:maxLines="5"
            android:minHeight="@dimen/touch_target" />

        <ImageButton
            android:id="@+id/button_send"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@drawable/bg_button_primary"
            android:contentDescription="@string/send"
            android:tint="@android:color/white"
            android:src="@drawable/ic_send" />
    </LinearLayout>
</LinearLayout>
