<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_surface"
        android:orientation="vertical"
        android:padding="@dimen/history_filter_gap">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/history_filter_control_height"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_search"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_text_field"
                android:hint="@string/search"
                android:singleLine="true"
                android:textSize="@dimen/history_filter_text" />

            <ImageButton
                android:id="@+id/button_search"
                android:layout_width="@dimen/history_filter_control_height"
                android:layout_height="@dimen/history_filter_control_height"
                android:layout_marginStart="@dimen/history_filter_gap"
                android:background="@drawable/bg_icon_small_ripple"
                android:contentDescription="@string/search"
                android:src="@drawable/ic_search"
                android:tint="@color/ic_tint" />

            <ImageButton
                android:id="@+id/button_clear_search"
                android:layout_width="@dimen/history_filter_control_height"
                android:layout_height="@dimen/history_filter_control_height"
                android:layout_marginStart="@dimen/history_filter_gap"
                android:background="@drawable/bg_icon_small_ripple"
                android:contentDescription="@string/clear"
                android:src="@drawable/ic_clear"
                android:tint="@color/ic_tint" />
        </LinearLayout>

        <RadioGroup
            android:id="@+id/group_type_filter"
            android:layout_width="match_parent"
            android:layout_height="@dimen/history_filter_row_height"
            android:layout_marginTop="@dimen/history_filter_gap"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/filter_all"
                style="@style/CompoundButtonHistoryRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:checked="true"
                android:text="All"
                android:textSize="@dimen/history_filter_text" />

            <RadioButton
                android:id="@+id/filter_images"
                style="@style/CompoundButtonHistoryRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Images"
                android:textSize="@dimen/history_filter_text" />

            <RadioButton
                android:id="@+id/filter_videos"
                style="@style/CompoundButtonHistoryRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Videos"
                android:textSize="@dimen/history_filter_text" />

            <RadioButton
                android:id="@+id/filter_files"
                style="@style/CompoundButtonHistoryRadio"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:text="Files"
                android:textSize="@dimen/history_filter_text" />
        </RadioGroup>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/history_filter_control_height"
            android:layout_marginTop="@dimen/history_filter_gap"
            android:orientation="horizontal">

            <EditText
                android:id="@+id/input_date_from"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_text_field"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/date_from"
                android:inputType="none"
                android:singleLine="true"
                android:textSize="@dimen/history_filter_text" />

            <EditText
                android:id="@+id/input_date_to"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/history_filter_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_text_field"
                android:clickable="true"
                android:focusable="false"
                android:hint="@string/date_to"
                android:inputType="none"
                android:singleLine="true"
                android:textSize="@dimen/history_filter_text" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="@dimen/history_filter_control_height"
            android:layout_marginTop="@dimen/history_filter_gap"
            android:orientation="horizontal">

            <com.ephemeral.android.ui.common.StyledSpinner
                android:id="@+id/spinner_recent"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_field"
                android:spinnerMode="dropdown" />

            <com.ephemeral.android.ui.common.StyledSpinner
                android:id="@+id/spinner_visibility"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_marginStart="@dimen/history_filter_gap"
                android:layout_weight="1"
                android:background="@drawable/bg_spinner_field"
                android:spinnerMode="dropdown" />
        </LinearLayout>

        <CheckBox
            android:id="@+id/check_search_body"
            style="@style/CompoundButtonHistory"
            android:layout_width="match_parent"
            android:layout_height="@dimen/history_filter_row_height"
            android:text="@string/body_search"
            android:textSize="@dimen/history_filter_text" />
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_history"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:padding="@dimen/space_sm" />

        <ProgressBar
            android:id="@+id/progress_history"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:visibility="gone" />

        <TextView
            android:id="@+id/text_history_empty"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:text="@string/no_results"
            android:textColor="@color/color_text_secondary"
            android:visibility="gone" />
    </FrameLayout>
</LinearLayout>
