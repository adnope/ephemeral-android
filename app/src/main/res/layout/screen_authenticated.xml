<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/toolbar_normal"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_lg"
        android:paddingEnd="@dimen/space_sm">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="@string/app_name"
            android:textColor="@color/color_text_primary"
            android:textSize="@dimen/text_title"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/button_logout"
            style="@style/TextButtonEphemeral"
            android:layout_width="wrap_content"
            android:layout_height="32dp"
            android:background="@drawable/bg_button_secondary_ripple"
            android:gravity="center"
            android:minWidth="64dp"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:text="@string/logout"
            android:textColor="@color/color_text_primary"
            android:textSize="12sp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="48dp"
        android:background="@color/color_surface"
        android:orientation="horizontal"
        android:padding="@dimen/space_sm">

        <TextView
            android:id="@+id/button_nav_chat"
            style="@style/TextButtonEphemeral"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_selected_ripple"
            android:gravity="center"
            android:text="@string/chat"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/button_nav_history"
            style="@style/TextButtonEphemeral"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:layout_weight="1"
            android:background="@drawable/bg_filter_unselected_ripple"
            android:gravity="center"
            android:text="@string/history"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/button_refresh"
            android:layout_width="@dimen/touch_target"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/space_sm"
            android:background="@drawable/bg_icon_small_ripple"
            android:contentDescription="@string/refresh"
            android:scaleType="center"
            android:src="@drawable/ic_refresh"
            android:tint="@color/ic_tint" />
    </LinearLayout>

    <com.ephemeral.android.ui.common.SwipePagerLayout
        android:id="@+id/pager_authenticated"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <LinearLayout
        android:id="@+id/panel_download_progress"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_panel"
        android:orientation="vertical"
        android:paddingStart="@dimen/space_lg"
        android:paddingTop="@dimen/space_sm"
        android:paddingEnd="@dimen/space_lg"
        android:paddingBottom="@dimen/space_sm"
        android:visibility="gone">

        <TextView
            android:id="@+id/text_download_progress"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="@color/color_text_primary"
            android:textSize="13sp"
            android:textStyle="bold" />

        <ProgressBar
            android:id="@+id/progress_download_total"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="8dp"
            android:layout_marginTop="@dimen/space_xs"
            android:max="100" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/toolbar_selection"
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@color/color_surface"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/button_selection_cancel"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/cancel"
            android:src="@drawable/ic_check"
            android:tint="@color/ic_tint" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/space_xs"
            android:orientation="vertical">

            <TextView
                android:id="@+id/text_selection_count"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/color_text_primary"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/text_selection_size"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/color_text_secondary"
                android:textSize="10sp" />
        </LinearLayout>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/button_selection_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete_custom"
            android:tint="@color/ic_tint" />

        <ImageButton
            android:id="@+id/button_selection_download"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/download"
            android:src="@drawable/ic_download_custom"
            android:tint="@color/ic_tint" />

        <ImageButton
            android:id="@+id/button_selection_all"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="?android:attr/selectableItemBackgroundBorderless"
            android:contentDescription="Select All"
            android:src="@drawable/ic_select_all_custom"
            android:tint="@color/ic_tint" />
    </LinearLayout>
</LinearLayout>
