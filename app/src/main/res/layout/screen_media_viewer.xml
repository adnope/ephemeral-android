<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="56dp"
        android:background="@drawable/bg_viewer_toolbar"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="@dimen/space_sm"
        android:paddingEnd="@dimen/space_sm">

        <ImageButton
            android:id="@+id/button_previous"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/view"
            android:src="@drawable/ic_previous"
            android:tint="@android:color/white" />

        <TextView
            android:id="@+id/text_media_title"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@android:color/white"
            android:textStyle="bold" />

        <ImageButton
            android:id="@+id/button_download"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/download"
            android:src="@drawable/ic_download"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_delete"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/delete"
            android:src="@drawable/ic_delete"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_close"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/close_viewer"
            android:src="@drawable/ic_close"
            android:tint="@android:color/white" />

        <ImageButton
            android:id="@+id/button_next"
            android:layout_width="@dimen/touch_target"
            android:layout_height="@dimen/touch_target"
            android:background="@android:color/transparent"
            android:contentDescription="@string/view"
            android:src="@drawable/ic_next"
            android:tint="@android:color/white" />
    </LinearLayout>

    <FrameLayout
        android:id="@+id/container_media"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/list_media_pages"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:clipToPadding="false"
            android:overScrollMode="never" />
    </FrameLayout>

    <TextView
        android:id="@+id/text_media_metadata"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_viewer_toolbar"
        android:padding="@dimen/space_md"
        android:textColor="@android:color/white"
        android:textSize="@dimen/text_small" />
</LinearLayout>
